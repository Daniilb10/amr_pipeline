params {
    input = "null"
    outdir = "results"

    genome_size = '5m' 
    min_length = 1000 
    min_quality = 10 
    dorado_model = null 
    dorado_device = 'auto' 
    bakta_db = null 
    amrfinder_db = null

}

process{
    executor = 'local'
    cpus = 1
    memory = '2 GB'
    time = '2h'

    errorStrategy = 'terminate'

}

timeline {
    enabled = true
    file = '${params.outdir}/pipeline_info/timeline.html'

}

report { enabled = true 
file = "${params.outdir}/pipeline_info/report.html" }

trace { enabled = true 
file = "${params.outdir}/pipeline_info/trace.txt" }

dag { enabled = true
file = "${params.outdir}/pipeline_info/dag.html" }

manifest {
    name = 'amr-ont-pipeline'
    author = 'Daniel Ilboudo'
    description = 'Nextflow pipeline for Oxford Nanopore bacterial genome analysis and AMR gene detection'
    mainScript = 'main.nf'
}
